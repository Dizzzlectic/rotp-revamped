function main()
	for mapName, info in pairs(mapNPCInfoTable) do
		for _, entry in pairs(info) do
			result, msg = AddTownInfo(mapName, entry.name, entry.X, entry.Y, entry.TYPE)
			if not result then
				return false, msg
			end
		end
	end
	return true, "good"
end
