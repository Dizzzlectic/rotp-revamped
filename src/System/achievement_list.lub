function main()
    for id, info in pairs(achievement_tbl) do
        result, msg = InsertAchieveInfo(id, info.title, info.content.summary, info.content.details, info.score)
        if not result then return false, msg end
        if info.resource ~= nil then
            for _, resource in ipairs(info.resource) do
                if resource.shortcut ~= nil then
                    shortcut = resource.shortcut
                else
                    shortcut = -1
                end
                if info.UI_Type == 0 then
                    result, msg = InsertAchieveResource(id, resource.text, 0, shortcut)
                elseif info.UI_Type == 1 then
                    result, msg = InsertAchieveResource(id, resource.text, resource.count, shortcut)
                end
                if not result then return false, msg end
            end
        end
        if info.reward ~= nil then
            if info.reward.item ~= nil then
                result, msg = InsertAchieveRewardItem(id, info.reward.item)
            end
            if info.reward.title ~= nil then
                result, msg = InsertAchieveRewardTitle(id, info.reward.title)
                if not result then return false, msg end
            end
            if info.reward.buff ~= nil then
                result, msg = InsertAchieveRewardBuff(id, info.reward.buff)
                if not result then return false, msg end
            end
        end
        result, msg = InsertAchieveUIType(id, info.UI_Type, info.group)
        if not result then return false, msg end
        result, msg = SetAchieveIDByTab(id, info.major, info.minor)
        if not result then return false, msg end
    end
    return true, "good"
end
